<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quotation with confidential cost breakup (old "Print with breakup") -->
    <record id="action_report_quote_breakup" model="ir.actions.report">
        <field name="name">Quotation with Cost Breakup (Confidential)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gbb_erp.report_quote_breakup</field>
        <field name="report_file">gbb_erp.report_quote_breakup</field>
        <field name="print_report_name">'%s - with breakup' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[(4, ref('gbb_erp.group_gbb_director')), (4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <template id="report_quote_breakup">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="sale.report_saleorder_document" t-lang="doc.partner_id.lang"/>
                <t t-call="web.external_layout">
                    <div class="page" style="page-break-before: always; font-family: Arial;">
                        <h4>Cost Break-Up (Confidential): <span t-field="doc.name"/> Rev <span t-field="doc.gbb_rev"/></h4>
                        <p>Machining factor: <span t-field="doc.gbb_machining_factor"/> x material</p>
                        <t t-foreach="doc.order_line.filtered(lambda l: l.gbb_breakup_ids)" t-as="line">
                            <p class="mt-3"><strong t-field="line.name"/> (Qty <span t-field="line.product_uom_qty"/>)</p>
                            <table class="table table-sm">
                                <thead><tr><th>Cost Head</th><th class="text-end">Qty</th><th class="text-end">Rate</th><th class="text-end">Amount</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="line.gbb_breakup_ids" t-as="b">
                                        <td><span t-field="b.name"/></td>
                                        <td class="text-end"><span t-if="b.qty" t-field="b.qty"/></td>
                                        <td class="text-end"><span t-if="b.rate" t-field="b.rate"/></td>
                                        <td class="text-end"><span t-field="b.amount"/></td>
                                    </tr>
                                    <tr><td colspan="3"><strong>Sub Total-1</strong></td><td class="text-end"><strong t-field="line.gbb_subtotal1"/></td></tr>
                                    <tr><td colspan="3">Profit (<span t-field="line.gbb_profit_pct"/>%)</td><td class="text-end"><span t-field="line.gbb_profit"/></td></tr>
                                    <tr><td colspan="3">Risk Factor</td><td class="text-end"><span t-field="line.gbb_risk"/></td></tr>
                                    <tr><td colspan="3"><strong>Total per fixture</strong></td><td class="text-end"><strong t-field="line.gbb_breakup_total"/></td></tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Printable checklist (ISO format) -->
    <record id="action_report_checklist" model="ir.actions.report">
        <field name="name">Checklist (ISO format)</field>
        <field name="model">gbb.checklist</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gbb_erp.report_checklist</field>
        <field name="report_file">gbb_erp.report_checklist</field>
        <field name="print_report_name">'%s' % (object.name)</field>
        <field name="binding_model_id" ref="gbb_erp.model_gbb_checklist"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_checklist">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial;">
                        <h4><span t-field="doc.template_id.name"/> <small class="text-muted" t-field="doc.doc_code"/></h4>
                        <table class="table table-sm">
                            <tr><td>No</td><td t-field="doc.name"/><td>Date</td><td t-field="doc.date"/></tr>
                            <tr><td>Project Code</td><td t-field="doc.project_id"/><td>Customer</td><td t-field="doc.partner_id"/></tr>
                            <tr><td>Fixture / Part</td><td t-field="doc.subject"/><td>Result</td><td t-field="doc.result"/></tr>
                        </table>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>#</th><th>Point</th><th>Answer</th><th>Remark</th></tr></thead>
                            <tbody>
                                <t t-set="n" t-value="0"/>
                                <tr t-foreach="doc.line_ids" t-as="l">
                                    <t t-if="l.is_section"><td colspan="4"><strong t-field="l.name"/></td></t>
                                    <t t-else="">
                                        <t t-set="n" t-value="n + 1"/>
                                        <td t-out="n"/>
                                        <td><span t-field="l.name"/>
                                            <small t-if="l.answer_type == 'measure'" class="text-muted">
                                                (<span t-out="l.spec"/>, <span t-out="l.instrument"/>)</small>
                                            <small t-elif="l.spec" class="text-muted">(<span t-out="l.spec"/>)</small></td>
                                        <td>
                                            <span t-if="l.answer_type == 'yesno'" t-field="l.answer_yn"/>
                                            <span t-if="l.answer_type == 'okrev'" t-field="l.answer_ok"/>
                                            <span t-if="l.answer_type in ('text', 'value')" t-field="l.answer_text"/>
                                            <span t-if="l.answer_type == 'measure'"><span t-out="l.actual or l.answer_text"/> <span t-field="l.measure_result"/></span>
                                            <span t-if="l.answer_type == 'tick'"><t t-if="l.checked">Done</t> <span t-if="l.qty" t-out="l.qty"/></span>
                                            <span t-if="l.answer_type == 'score'" t-out="l.score"/>
                                        </td>
                                        <td t-field="l.remark"/>
                                    </t>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row mt-4">
                            <div class="col-4">Prepared By: <span t-field="doc.prepared_by_id"/></div>
                            <div class="col-4">Checked By: <span t-out="', '.join(doc.checked_by_ids.mapped('name'))"/></div>
                            <div class="col-4">Approved By: <span t-field="doc.approved_by_id"/></div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
